# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ (.env ไม่ถูก commit)
#   cp .env.example .env

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inspection
POSTGRES_PORT=5432

# --- Backend ---
# ต้องตรงกับค่าด้านบน
DATABASE_URL=postgresql://appuser:change-me@localhost:5432/inspection
